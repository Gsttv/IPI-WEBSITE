{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "IPI Theme",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "name": "Verde institucional", "color": "#667058" },
				{ "slug": "primary-dark", "name": "Verde institucional (escuro)", "color": "#49513d" },
				{ "slug": "primary-light", "name": "Verde institucional (claro)", "color": "#eef2e9" },
				{ "slug": "cream", "name": "Creme", "color": "#e5dccc" },
				{ "slug": "ink", "name": "Marrom escuro", "color": "#473f30" },
				{ "slug": "accent", "name": "Destaque (aviso/foco)", "color": "#f5a623" },
				{ "slug": "text", "name": "Texto", "color": "#242720" },
				{ "slug": "text-muted", "name": "Texto secundário", "color": "#606657" },
				{ "slug": "background", "name": "Fundo", "color": "#ffffff" },
				{ "slug": "background-alt", "name": "Fundo alternativo", "color": "#f6f3ef" },
				{ "slug": "danger", "name": "Alerta/Emergência", "color": "#b3261e" }
			]
		},
		"typography": {
			"customFontSize": false,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "General Sans",
					"fontFamily": "'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeno", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Médio", "size": "1.125rem" },
				{ "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra grande", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Título", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "1" },
				{ "slug": "30", "size": "1rem", "name": "2" },
				{ "slug": "40", "size": "1.5rem", "name": "3" },
				{ "slug": "50", "size": "2.5rem", "name": "4" },
				{ "slug": "60", "size": "4rem", "name": "5" },
				{ "slug": "70", "size": "6rem", "name": "6" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "6px"
				}
			}
		}
	},
	"customTemplates": [],
	"templateParts": []
}
