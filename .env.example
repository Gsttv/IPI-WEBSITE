# Copie este arquivo para ".env" (mesma pasta) antes de rodar o Docker.
# O ".env" real fica de fora do Git — cada dev/máquina pode ter o seu.

# Banco de dados
DB_ROOT_PASSWORD=root
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress

# Portas expostas na sua máquina (mude se já estiver em uso)
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081

# 1 para ativar WP_DEBUG dentro do container
WORDPRESS_DEBUG=0
